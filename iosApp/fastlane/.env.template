# Copy this file to `.env` (which is gitignored) and fill in real values for LOCAL runs.
# In CI these are provided as GitHub Actions secrets — do NOT commit real values.

# App Store Connect API key (account-level; reused from CCC)
APP_STORE_CONNECT_ISSUER_ID=""
APP_STORE_CONNECT_KEY_ID=""
APP_STORE_CONNECT_KEY_CONTENT="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Firebase iOS App ID (1:xxxx:ios:xxxx) for the AdTrace Firebase project
FIREBASE_IOS_APP_ID=""

# Path to the decrypted Google service-account JSON used for Firebase App Distribution.
# In CI this is decrypted from the FIREBASE_SERVICE_ACCOUNT secret; locally point it at your JSON.
FIREBASE_SERVICE_ACCOUNT_FILE="../firebase-service-account.json"

# PAT with read access to the private Oztechan/adtrace-ios-credentials repo (used by match)
GIT_AUTHORIZATION=""

# Passphrase for the temporary keychain and match encryption
SECRET_PASSWORD=""
MATCH_PASSWORD=""
