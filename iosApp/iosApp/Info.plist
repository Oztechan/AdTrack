    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AdTrack</string>
    <!-- AdMob App ID, injected from Config.xcconfig (ADMOB_APP_ID). Google's public test App ID by
         default; the real one is passed as a build setting at release time. -->
    <key>GADApplicationIdentifier</key>
    <string>$(ADMOB_APP_ID)</string>
    <!-- Shown in the App Tracking Transparency prompt; required before requesting tracking authorization. -->
    <key>NSUserTrackingUsageDescription</key>
    <string>Allow tracking to see ads more relevant to you. You can still use AdTrack fully either way.</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Required by Compose Multiplatform for high-refresh-rate performance. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageName</key>
        <string>LaunchLogo</string>
        <key>UIImageRespectsSafeAreaInsets</key>
        <true/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- OAuth redirect custom scheme. Must match OAUTH_REDIRECT_SCHEME. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.oztechan.adtrack.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.oztechan.adtrack</string>
            </array>
        </dict>
    </array>

